# MySQL
MYSQL_DATABASE=event_ticketing
MYSQL_USER=ticketing_user
MYSQL_PASSWORD=change_this_user_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# MySQL connection used by FastAPI inside Docker Compose
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=event_ticketing

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Redis cache configuration
EVENT_CACHE_TTL_SECONDS=120